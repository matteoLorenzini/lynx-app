<http://www.lynx-platform.com/field/height/context> {
  <http://www.lynx-platform.com/field/height> a <http://www.w3.org/ns/ldp#Resource>,
      <http://www.researchspace.org/resource/system/fields/Field>, prov:Entity;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:t23266;
    prov:wasAttributedTo User:admin;
    <http://www.researchspace.org/resource/system/fields/range> crm:E54_Dimension;
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> xsd:string;
    <http://www.researchspace.org/resource/system/fields/domain> crm:E18_Physical_Thing;
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:t23267;
    rdfs:label "Height"@en;
    <http://www.researchspace.org/resource/system/fields/category> <http://www.researchspace.org/resource/system/category/dimension>;
    prov:generatedAtTime "2026-09-28T21:24:04.647Z"^^xsd:dateTime .
  
  _:t23267 a sp:Query;
    sp:text """SELECT ?value WHERE {
    $subject a crm:E18_Physical_Thing;
             crm:P43_has_dimension ?dimension.

    ?dimension a crm:E54_Dimension;
               crm:P2_has_type <http://www.lynx.com/resource/cultural-heritage-object/dimension/height>;
               crm:P91_has_unit ?unit;
               rdfs:label ?dimensionValue.

    BIND(
        CONCAT(
            STR(?dimensionValue),
            \" \",
            STRAFTER(STR(?unit), \"/dimension-unit/\")
        )
        AS ?value
    )
}""" .
  
  _:t23266 a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .
  
  _:node1k7ng5bsqx470 <http://www.w3.org/ns/ldp#contains> <http://www.lynx-platform.com/field/height> .
}

