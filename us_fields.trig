    <http://www.researchspace.org/resource/system/fields/insertPattern> _:t30001;
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:t30002;
    <http://www.researchspace.org/resource/system/fields/category> <http://www.researchspace.org/resource/system/category/identifier>;
    <http://www.researchspace.org/resource/system/fields/range> crm:E42_Identifier .

  _:t30002 a sp:Query;
    sp:text """SELECT ?value WHERE {
  $subject a crmarchaeo:A2_Stratigraphic_Volume_Unit;
    crm:P1_is_identified_by ?identifier.
    ?identifier a crm:E42_Identifier;
                crm:P2_has_type <http://www.lynx.com/resource/global-id>;
                rdfs:label ?value
}""" .

  _:t30001 a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .

