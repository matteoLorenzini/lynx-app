<http://www.lynx-platform.com/field/us_typology/context> {
  <http://www.lynx-platform.com/field/us_typology> a prov:Entity, <http://www.researchspace.org/resource/system/fields/Field>,
      <http://www.w3.org/ns/ldp#Resource>;
    prov:generatedAtTime "2026-10-13T20:06:10.807Z"^^xsd:dateTime;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:t23813;
    <http://www.researchspace.org/resource/system/fields/category> <http://www.researchspace.org/resource/system/category/type>;
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:t23812;
    rdfs:label "US Typology"@en;
    <http://www.researchspace.org/resource/system/fields/domain> crmarchaeo:A2_Stratigraphic_Volume_Unit;
    <http://www.researchspace.org/resource/system/fields/range> crm:E55_Type;
    prov:wasAttributedTo User:admin;
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> xsd:string .
  
  _:t23812 a sp:Query;
    sp:text """SELECT ?value WHERE {
  $subject a crmarchaeo:A2_Stratigraphic_Volume_Unit;
    crm:P2_has_type ?type.
    ?type a crm:E55_Type;
          rdfs:label ?value.
    FILTER(CONTAINS(STR(?type), \"/tipologia/\"))
}""" .
  
  _:t23813 a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .
  
  _:node1k7ng5bsqx503 <http://www.w3.org/ns/ldp#contains> <http://www.lynx-platform.com/field/us_typology> .
}

