    <http://www.researchspace.org/resource/system/fields/category> <http://www.researchspace.org/resource/system/category/actor>;
    <http://www.researchspace.org/resource/system/fields/domain> crmarchaeo:A2_Stratigraphic_Volume_Unit;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:t23753;
    rdfs:label "Responsible Body"@en;
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:t23752;
    <http://www.researchspace.org/resource/system/fields/range> crm:E74_Group;
    prov:generatedAtTime "2026-10-13T20:06:08.706Z"^^xsd:dateTime;
    prov:wasAttributedTo User:admin;
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> xsd:string .
  
  _:t23752 a sp:Query;
    sp:text """SELECT ?value WHERE {
  $subject a crmarchaeo:A2_Stratigraphic_Volume_Unit;
    crm:P105_right_held_by ?group.
    ?group a crm:E74_Group.
    FILTER(CONTAINS(STR(?group), \"/ente-responsabile/\"))
    OPTIONAL { ?group rdfs:label ?groupLabel }
    BIND(COALESCE(?groupLabel, STRAFTER(STR(?group), \"/ente-responsabile/\")) AS ?value)
}""" .
  
  _:t23753 a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .
  
  _:node1k7ng5bsqx492 <http://www.w3.org/ns/ldp#contains> <http://www.lynx-platform.com/field/us_responsible_body> .
