  <http://www.lynx-platform.com/field/person_birth_place> a <http://www.researchspace.org/resource/system/fields/Field>,
      <http://www.w3.org/ns/ldp#Resource>, prov:Entity;
    rdfs:label "Place of Birth"@en;
    prov:generatedAtTime "2026-11-21T22:30:00.561Z"^^xsd:dateTime;
    prov:wasAttributedTo User:admin;
    <http://www.researchspace.org/resource/system/fields/domain> crm:E21_Person;
    <http://www.researchspace.org/resource/system/fields/range> crm:E53_Place;
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> xsd:anyURI;
    <http://www.researchspace.org/resource/system/fields/category> <http://www.researchspace.org/resource/system/category/place>;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:person03i;
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:person03s .

  _:person03i a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .

  _:person03s a sp:Query;
    sp:text """SELECT ?value ?label WHERE {
  $subject a crm:E21_Person;
    crm:P98i_was_born ?birth.
  ?birth a crm:E67_Birth;
    crm:P7_took_place_at ?value.
  ?value a crm:E53_Place;
    crm:P2_has_type <http://www.lynx.com/resource/birth-place>.
  OPTIONAL { ?value rdfs:label ?placeLabel }
  BIND(COALESCE(?placeLabel,
    REPLACE(REPLACE(REPLACE(STRAFTER(STR(?value), \"/place/\"), \"%20\", \" \"), \"%28\", \"(\"), \"%29\", \")\")) AS ?label)
}""" .

  _:person03c <http://www.w3.org/ns/ldp#contains> <http://www.lynx-platform.com/field/person_birth_place> .
}

