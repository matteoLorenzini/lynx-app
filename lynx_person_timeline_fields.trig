    <http://www.researchspace.org/resource/system/fields/insertPattern> _:timeline12i;
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:timeline12s .

  _:timeline12i a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .

  _:timeline12s a sp:Query;
    sp:text """SELECT DISTINCT ?value ?label WHERE {
  $subject a crm:E21_Person .
  { $subject crm:P11i_took_part_in ?activity. }
  UNION
  { $subject crm:P14i_performed ?activity. }
  ?activity crm:P7_took_place_at ?value.
  ?value a crm:E53_Place .
  OPTIONAL { ?value rdfs:label ?label }
}""" .

