<http://www.lynx-platform.com/field/us_global_id/context> {
  <http://www.lynx-platform.com/field/us_global_id> a <http://www.researchspace.org/resource/system/fields/Field>,
      <http://www.w3.org/ns/ldp#Resource>, prov:Entity;
    <http://www.researchspace.org/resource/system/fields/domain> crmarchaeo:A2_Stratigraphic_Volume_Unit;
    rdfs:label "US Global ID"@en;
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> xsd:string;
    prov:generatedAtTime "2026-10-13T09:00:00.000Z"^^xsd:dateTime;
