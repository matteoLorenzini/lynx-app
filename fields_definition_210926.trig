    rdfs:label "Length"@en .
  
  _:t23472 a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .
  
  _:t23473 a sp:Query;
    sp:text """SELECT ?value WHERE {
    $subject a crm:E18_Physical_Thing;
             crm:P43_has_dimension ?dimension.

    ?dimension a crm:E54_Dimension;
               crm:P2_has_type <http://www.lynx.com/resource/cultural-heritage-object/dimension/lenght>;
               crm:P91_has_unit ?unit;
               rdfs:label ?dimensionValue.

    BIND(
        CONCAT(
            STR(?dimensionValue),
            \" \",
            STRAFTER(STR(?unit), \"/dimension-unit/\")
        )
        AS ?value
    )
}""" .
  
  _:node1k32orpejx507 <http://www.w3.org/ns/ldp#contains> <http://www.lynx-platform.com/field/length> .
