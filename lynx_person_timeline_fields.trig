  <http://www.lynx-platform.com/field/timeline_participant_role> a <http://www.researchspace.org/resource/system/fields/Field>,
      <http://www.w3.org/ns/ldp#Resource>, prov:Entity;
    rdfs:label "Participant Role"@en;
    prov:generatedAtTime "2026-11-21T22:35:03.740Z"^^xsd:dateTime;
    prov:wasAttributedTo User:admin;
    <http://www.researchspace.org/resource/system/fields/domain> crm:E7_Activity;
    <http://www.researchspace.org/resource/system/fields/range> crm:E55_Type;
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> xsd:string;
    <http://www.researchspace.org/resource/system/fields/category> <http://www.researchspace.org/resource/system/category/actor>;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:timeline20i;
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:timeline20s .

  _:timeline20i a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .

  _:timeline20s a sp:Query;
    sp:text """SELECT ?value WHERE {
  $subject a crm:E7_Activity;
    crm:P01i_is_domain_of ?participation.
  ?participation a crm:PC14_carried_out_by;
    <http://www.cidoc-crm.org/cidoc-crm/P14.1_in_the_role_of> ?role;
    crm:P02_has_range ?actor.
  ?role rdfs:label ?roleLabel.
  ?actor rdfs:label ?actorLabel.
  BIND(CONCAT(STR(?actorLabel), \" (\", STR(?roleLabel), \")\") AS ?value)
}""" .

  _:timeline20c <http://www.w3.org/ns/ldp#contains> <http://www.lynx-platform.com/field/timeline_participant_role> .
