<http://www.lynx-platform.com/field/depth/context> {
  <http://www.lynx-platform.com/field/depth> a <http://www.researchspace.org/resource/system/fields/Field>,
      prov:Entity, <http://www.w3.org/ns/ldp#Resource>;
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:t23282;
    rdfs:label "Depth"@en;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:t23281;
    <http://www.researchspace.org/resource/system/fields/domain> crm:E18_Physical_Thing;
    <http://www.researchspace.org/resource/system/fields/category> <http://www.researchspace.org/resource/system/category/dimension>;
    prov:generatedAtTime "2026-09-28T21:24:05.231Z"^^xsd:dateTime;
    <http://www.researchspace.org/resource/system/fields/range> crm:E54_Dimension;
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> xsd:string;
    prov:wasAttributedTo User:admin .
  
  _:t23282 a sp:Query;
    sp:text """SELECT ?value WHERE {
    $subject a crm:E18_Physical_Thing;
             crm:P43_has_dimension ?dimension.

    ?dimension a crm:E54_Dimension;
               crm:P2_has_type <http://www.lynx.com/resource/cultural-heritage-object/dimension/depth>;
               crm:P91_has_unit ?unit;
               rdfs:label ?dimensionValue.

    BIND(
        CONCAT(
            STR(?dimensionValue),
            \" \",
            STRAFTER(STR(?unit), \"/dimension-unit/\")
        )
        AS ?value
    )
}""" .
  
  _:t23281 a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .
  
  _:node1k7ng5bsqx460 <http://www.w3.org/ns/ldp#contains> <http://www.lynx-platform.com/field/depth> .
}

