    <http://www.researchspace.org/resource/system/fields/selectPattern> _:t23477;
    rdfs:label "Width"@en;
    <http://www.researchspace.org/resource/system/fields/category> <http://www.researchspace.org/resource/system/category/dimension>;
    prov:generatedAtTime "2026-09-21T20:14:09.755Z"^^xsd:dateTime;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:t23478;
    <http://www.researchspace.org/resource/system/fields/range> crm:E54_Dimension;
    prov:wasAttributedTo User:admin;
    <http://www.researchspace.org/resource/system/fields/domain> crm:E18_Physical_Thing .
  
  _:t23477 a sp:Query;
    sp:text """SELECT ?value WHERE {
    $subject a crm:E18_Physical_Thing;
             crm:P43_has_dimension ?dimension.

    ?dimension a crm:E54_Dimension;
               crm:P2_has_type <http://www.lynx.com/resource/cultural-heritage-object/dimension/width>;
               crm:P91_has_unit ?unit;
               rdfs:label ?dimensionValue.

    BIND(
        CONCAT(
            STR(?dimensionValue),
            \" \",
            STRAFTER(STR(?unit), \"/dimension-unit/\")
        )
        AS ?value
    )
}""" .
  
  _:t23478 a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .
  
  _:node1k32orpejx514 <http://www.w3.org/ns/ldp#contains> <http://www.lynx-platform.com/field/width> .
