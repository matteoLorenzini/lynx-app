<http://www.lynx-platform.com/field/person_occupation/context> {
  <http://www.lynx-platform.com/field/person_occupation> a <http://www.researchspace.org/resource/system/fields/Field>,
      <http://www.w3.org/ns/ldp#Resource>, prov:Entity;
    rdfs:label "Occupation"@en;
    prov:generatedAtTime "2026-11-21T22:30:01.122Z"^^xsd:dateTime;
    prov:wasAttributedTo User:admin;
    <http://www.researchspace.org/resource/system/fields/domain> crm:E21_Person;
    <http://www.researchspace.org/resource/system/fields/range> crm:E55_Type;
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> xsd:string;
    <http://www.researchspace.org/resource/system/fields/category> <http://www.researchspace.org/resource/system/category/type>;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:person06i;
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:person06s .

  _:person06i a sp:Query;
    sp:text "INSERT { $subject ?predicate $value} WHERE {}" .

  _:person06s a sp:Query;
    sp:text """SELECT ?value WHERE {
  $subject a crm:E21_Person;
    crm:P2_has_type ?occupation.
  ?occupation a crm:E55_Type;
    rdfs:label ?value.
  FILTER(CONTAINS(STR(?occupation), \"/type/occupation/\"))
}""" .

  _:person06c <http://www.w3.org/ns/ldp#contains> <http://www.lynx-platform.com/field/person_occupation> .
}

{
  _:person06c a <http://www.w3.org/ns/ldp#Container>, <http://www.w3.org/ns/ldp#Resource>,
      prov:Entity .
}
